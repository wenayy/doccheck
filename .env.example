# Pick ONE model. Format: provider:model
# anthropic:claude-opus-5 | openai:<model> | deepseek:deepseek-v4-flash-vision-exp | custom:<model>
LLM_MODEL=anthropic:claude-opus-5

# Fill only the key for the provider chosen above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Any OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama).
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
